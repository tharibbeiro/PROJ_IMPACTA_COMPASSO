@startuml arquitetura
left to right direction
skinparam backgroundColor #FAFBFC
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 18
skinparam shadowing false
skinparam roundcorner 12
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 40
skinparam ArrowColor #607286
skinparam RectangleBorderColor #547477
skinparam DatabaseBorderColor #547477
skinparam titleFontColor #173D43
skinparam titleFontSize 24
skinparam dpi 120

title Compasso Acadêmico\nAs três camadas do projeto

rectangle "1. Interface\nReact + HTML + CSS\nIndex.html / HtmlService" as Interface #E7F4EF
rectangle "2. Aplicação\nGoogle Apps Script\nRegras e validações" as Aplicacao #EAF1F8
database "3. Dados\nGoogle Sheets\nAbas da planilha privada" as Dados #FFF4DF

Interface <--> Aplicacao : google.script.run
Aplicacao <--> Dados : leitura e gravação

legend bottom
  A interface chama as funções do Apps Script, que validam as operações e salvam os dados.
  A planilha é acessada pelo servidor; a aplicação precisa de conexão com a internet.
endlegend
@enduml
